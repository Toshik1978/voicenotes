# Example systemd unit for the voicenotes-mic recorder. Install the binary to
# /usr/local/bin, copy voicenotes-mic.env.example to /usr/local/etc/voicenotes-mic.env
# (mode 0600) and fill it in, create the user, then enable the unit:
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin voicenotes-mic
#   sudo systemctl enable --now voicenotes-mic
[Unit]
Description=VoiceNotes microphone recorder
# time-sync.target holds the start only on a host whose time service has a wait
# unit enabled (systemd-time-wait-sync, chrony-wait): a host without a real-time
# clock then records with the right time. Wants= still starts it if that fails.
Wants=network-online.target sound.target time-sync.target
After=network-online.target sound.target time-sync.target

[Service]
User=voicenotes-mic
SupplementaryGroups=audio input
StateDirectory=voicenotes-mic
StateDirectoryMode=0700
EnvironmentFile=/usr/local/etc/voicenotes-mic.env
ExecStart=/usr/local/bin/voicenotes-mic
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
