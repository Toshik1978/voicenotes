# voicenotes-mic recorder settings. Copy to /usr/local/etc/voicenotes-mic.env (mode 0600).
# All values below are fake examples; commented lines show the defaults.

# Required: the VoiceNotes service and the shared upload token (32+ characters).
# A reverse proxy in front of the service must accept request bodies of at least
# the service's MIC_UPLOAD_MAX_BYTES (nginx: client_max_body_size).
MIC_SERVER_URL=https://voicenotes.example.org
MIC_UPLOAD_TOKEN=FAKE-0123456789abcdef0123456789abcdef

# Name sent with each recording (A-Z a-z 0-9 . _ -, up to 64). Default: hostname.
#MIC_RECORDER_NAME=kitchen-pi

# Audio and input device; set both or neither (empty means auto-discovery).
#MIC_CAPTURE_DEVICE=
#MIC_INPUT_DEVICE=

# Recording behaviour. MIC_MIN_LENGTH must be shorter than MIC_MAX_LENGTH.
#MIC_DEBOUNCE=500ms
#MIC_MIN_LENGTH=2s
#MIC_MAX_LENGTH=10m

# Spool directory. Default: $STATE_DIRECTORY, else /var/lib/voicenotes-mic.
#MIC_SPOOL_DIR=
#MIC_SPOOL_MIN_FREE=268435456

# Upload retry and check-in timing. Keep MIC_CHECKIN_INTERVAL below the
# service's MIC_SILENCE_ALERT (default 5m), or its silence alert flaps.
#MIC_CHECKIN_INTERVAL=1m
#MIC_RETRY_MAX_INTERVAL=5m
#MIC_PENDING_THRESHOLD=30m

# Health endpoint and logging.
#MIC_HTTP_ADDR=127.0.0.1:8081
#LOG_LEVEL=info
