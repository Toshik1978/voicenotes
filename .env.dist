# VoiceNotes configuration. Copy to .env and fill in real values; .env is git-ignored.
# Secrets (marked SECRET) must come from the environment and are never logged.
# A missing or invalid required variable stops startup with "config: <VAR>: <problem>".

# --- Telegram ---------------------------------------------------------------
# SECRET. Token of the dedicated VoiceNotes bot. Required.
TELEGRAM_BOT_TOKEN=123456:FAKE-TOKEN
# Comma-separated Telegram user IDs allowed to capture. Required.
TELEGRAM_ALLOWED_USERS=123456789
# Chat that receives the morning digest. Default: first of TELEGRAM_ALLOWED_USERS.
# DIGEST_CHAT_ID=-1001234567890

# --- Speech-to-text (OpenAI-compatible) -------------------------------------
# Base URL including /v1. Required.
STT_BASE_URL=http://192.0.2.10:8000/v1
# SECRET. Bearer key. Default: empty (no auth header).
# STT_API_KEY=FAKE-STT-KEY
# Model id passed as "model". Required.
STT_MODEL=whisper-1
# verbose_json (reports the detected language) or json (for models that reject verbose_json).
# STT_RESPONSE_FORMAT=verbose_json
# Per-request timeout. Default: 120s.
# STT_TIMEOUT=120s

# --- Languages --------------------------------------------------------------
# Comma-separated ISO-639-1 codes the owner speaks, first = preferred. Default: empty = auto-detect.
# SOURCE_LANGUAGES=en,ru
# ISO-639-1 code that notes are translated into. Default: en.
# TARGET_LANGUAGE=en

# --- LLM (optional, OpenAI-compatible chat) ---------------------------------
# The LLM step is enabled only when LLM_BASE_URL is set.
# Base URL including /v1 (for example a LiteLLM gateway).
# LLM_BASE_URL=http://192.0.2.10:4000/v1
# SECRET. Bearer key. Default: empty.
# LLM_API_KEY=FAKE-LLM-KEY
# Model name or gateway alias. Required if the LLM is on.
# LLM_MODEL=notes-model
# Translate to TARGET_LANGUAGE. Default: true.
# LLM_TRANSLATE=true
# Tidy punctuation and suggest tags. Default: true.
# LLM_TIDY=true
# Spot action items -> checklist + #todo. Default: true.
# LLM_TASKS=true
# One-line summaries in the digest. Default: true.
# LLM_DIGEST_SUMMARY=true
# Upper bound on suggested tags. Default: 3.
# LLM_MAX_TAGS=3
# Per-request timeout. Default: 60s.
# LLM_TIMEOUT=60s
# Sampling temperature, 0-2. Default: unset, so none is sent and the model
# uses its own default (some models accept no other value).
# LLM_TEMPERATURE=

# --- Documents and photos (all optional) ------------------------------------
# docling-serve base URL; enables reading the content of files. Without it,
# files are saved with placeholder hints. A suggestion, not a requirement.
# No OCR options are sent: the server's OCR preset decides.
# DOCLING_URL=http://docling.example.org:5001
# SECRET. Sent as X-Api-Key. Ignored without DOCLING_URL.
# DOCLING_API_KEY=
# Wait per file, submit to result. Default: 10m.
# DOCLING_TIMEOUT=10m
# Leading pages converted per document, 1-1000. Default: 20.
# DOCLING_MAX_PAGES=20
# Quiet time that closes a batch of photos and files, 500ms-1m. Default: 3s.
# BATCH_QUIET_PERIOD=3s
# Extracted text sent to the LLM per batch, 500-50000 runes. Default: 4000.
# HINT_EXCERPT_RUNES=4000
# Describe photos with a vision-capable model when no text was read. Default: false.
# VISION_ENABLED=false
# Default: LLM_BASE_URL.
# VISION_BASE_URL=https://llm.example.org/v1
# SECRET. Default: LLM_API_KEY. Set it whenever VISION_BASE_URL points to
# another host, or the LLM key is sent to that host.
# VISION_API_KEY=
# Default: LLM_MODEL.
# VISION_MODEL=example-vision-model
# Per-request timeout. Default: 60s.
# VISION_TIMEOUT=60s

# --- Memos ------------------------------------------------------------------
# Internal base URL the service calls. Required.
MEMOS_URL=https://memos.example.org
# SECRET. Personal Access Token (memos_pat_...) of the owner account, no expiry. Required.
MEMOS_TOKEN=memos_pat_FAKE
# Base URL used in links shown to the owner. Default: MEMOS_URL.
# MEMOS_PUBLIC_URL=https://memos.example.org
# auto probes /api (26.10+) then /api/v1 (v0.31); or set /api/v1 or /api explicitly. Default: auto.
# MEMOS_API_PREFIX=auto
# Max note content bytes; match the Memos instance setting. Default: 8192.
# MEMOS_CONTENT_LIMIT=8192
# Tag for unreviewed notes. Default: inbox.
# INBOX_TAG=inbox
# Tag for notes with action items. Default: todo.
# TODO_TAG=todo

# --- Digest -----------------------------------------------------------------
# Turn the morning digest on or off. Default: true.
# DIGEST_ENABLED=true
# Local time HH:MM in TZ. Default: 07:30.
# DIGEST_TIME=07:30
# Send a missed digest if started within this window. Default: 3h.
# DIGEST_CATCHUP=3h
# Lines listed before "...and N more". Default: 30.
# DIGEST_MAX_NOTES=30

# --- Runtime ----------------------------------------------------------------
# SQLite file and queued audio and files; mount a persistent volume here. Default: /data.
DATA_DIR=./data
# Health listener. Must listen on loopback (:port or 0.0.0.0:port) for
# `voicenotes health`. Default: :8080.
# HTTP_ADDR=:8080
# Oldest unfinished capture older than this -> degraded. Default: 30m.
# HEALTH_PENDING_THRESHOLD=30m
# Backoff cap for dependency retries. Default: 5m.
# RETRY_MAX_INTERVAL=5m
# debug | info | warn | error. Default: info.
# LOG_LEVEL=info
# Standard IANA time zone (tzdata is embedded) for the digest time and the
# dates in attachment names. An unknown zone fails startup. Default: unset (UTC).
# TZ=Europe/Berlin
